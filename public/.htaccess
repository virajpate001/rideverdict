RewriteEngine On

# Force HTTPS + non-www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://rideverdict.in%{REQUEST_URI} [L,R=301]

# Old WordPress URLs → new equivalents
RedirectMatch 301 ^/sitemap_index\.xml$ /sitemap.xml
RedirectMatch 301 ^/(post|page|category)-sitemap\.xml$ /sitemap.xml
RedirectMatch 301 ^/feed/?$ /feed.xml
# Add any renamed posts here:
# Redirect 301 /old-slug/ /new-slug/

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>